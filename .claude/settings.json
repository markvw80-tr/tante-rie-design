{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python3 scripts/*)",
      "Bash(python3 \"$HOME/tante-rie/tante-rie-seo/scripts/mailbox.py\"*)",
      "Bash(shopify theme list*)",
      "Bash(shopify theme pull*)",
      "Bash(shopify theme check*)",
      "Bash(graphify query*)",
      "Bash(graphify update*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(shopify theme publish*)",
      "Bash(shopify theme push*--live*)",
      "Bash(shopify theme push*-l *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/sessiestart.py\"",
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/themapoort.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/changelogcontrole.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tante-rie-huisregels@tante-rie": true
  },
  "extraKnownMarketplaces": {
    "tante-rie": {
      "source": {
        "source": "directory",
        "path": "/Users/markvanwijk/tante-rie/tante-rie-hq"
      }
    }
  }
}
